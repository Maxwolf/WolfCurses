<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="CLAUDE.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WolfCurses.csproj" />
  </ItemGroup>

  <!-- Granted to this app's OWN test project and nowhere else, exactly as the two sibling examples do it. Nothing
       references that test project in turn, which is the direction the whole split exists to protect: the library's
       own tests must never learn an example exists, because the package ships without them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="WolfCurses.Apps.Tests" />
  </ItemGroup>

  <!-- No PackageReferences here, and there should not be any: everything is the .NET base class library plus
       WolfCurses, which is the whole claim these examples exist to back up. -->

  <ItemGroup>
    <!-- The sample documents, flattened next to the executable into a documents/ folder, which is where the word
         processor opens and where its Open dialog starts. Provenance and licensing for each file are in
         Assets/documents/README.md; all of them are freely redistributable.

         Deliberately two shapes of document. The RFCs are hard-wrapped at 72 columns with form feeds as page
         breaks, so they are what the print feature is tested against; hamlet.txt is 4,550 lines of prose and
         dialogue, which is the scrolling fixture and long enough that anything accidentally quadratic in the
         document model shows up by hand rather than only in a test. -->
    <None Include="Assets\documents\*.txt" Link="documents\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The spelling word list, in its own folder so the Open dialog never offers it as a document to edit. It is
         public domain (Unlicense); see Assets/dictionary/README.md for why a shorter frequency list was rejected on
         licensing rather than on size. -->
    <None Include="Assets\dictionary\words.txt" Link="dictionary\words.txt"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The sample sheet, in its own folder so the spreadsheet's Open dialog starts on it. Written for this
         repository; see Assets/sheets/README.md for what is in it and why it is shaped the way it is. -->
    <None Include="Assets\sheets\*.csv" Link="sheets\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The sample BASIC programs, in their own folder so the environment's Open dialog starts among them. All of
         them were written for this repository: the QBasic samples everybody remembers are Microsoft's and are not
         redistributable, so a program like GORILLA.BAS is opened from your own disk rather than shipped here. -->
    <None Include="Assets\programs\*.bas" Link="programs\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
