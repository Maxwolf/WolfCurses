<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WolfCurses.csproj" />
  </ItemGroup>

  <!-- Granted to this app's OWN test project and nowhere else, exactly as WolfCurses.Demo does it. The rules
       classes are fully public; what this opens up is the handful of internal seams that let a test build an exact
       position - a warhead here, a fireball there - instead of advancing a randomised wave until something like the
       scenario it means happens to turn up. Fishing for a situation in random state is how this repository has
       already shipped two flaky tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="WolfCurses.Games.Tests" />
  </ItemGroup>

  <!-- Still no PackageReferences, and there should not be any: everything here is BCL plus the library, which is
       the whole claim these examples exist to back up. Snake, Minesweeper and Tetris also copy no content, being
       made of characters. WolfChess 5000 is the exception and needs to be, since a chess game drawn with real
       piece artwork is what exercises the graphics stack. -->
  <ItemGroup>
    <!-- The twelve piece sprites, flattened next to the executable into a chess/ folder. 8-bit RGBA PNG, ~48x48,
         from github.com/samboy/ChessGraphics, which places them in the public domain (Unlicense / BSD-0) and asks
         for no attribution - credited anyway, because where art came from is worth being able to look up. They are
         decoded by the library's own PNG decoder like everything else here. -->
    <None Include="Assets\chess\*.png" Link="chess\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- The fifty-two card faces and one back, flattened next to the executable into a cards/ folder. 75x113 8-bit
         RGBA PNG, from github.com/saulspatz/SVGCards (the Vertical2 deck), placed in the public domain by its author
         - the picture cards originate in Byron Knoll's public-domain set and the backs in openclipart.org. No
         attribution is required; it is credited anyway, in CardImages, because where art came from is worth being
         able to look up.

         Only that repository's pngs/ folders are usable. Its SVGs are the source of truth there, and this library
         decodes PNG, JPEG and GIF - exactly the situation that made only SmallPng/ usable for the chess pieces. -->
    <None Include="Assets\cards\*.png" Link="cards\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
