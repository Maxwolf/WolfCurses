<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- References the APPS suite, and nothing references this. That direction is the whole point of the project
       existing separately: WolfCurses.Tests tests the library and must never learn that an example exists, because
       the package has to ship without them. Anything here is free to reach into the example, since the example is
       already downstream of the library. -->
  <ItemGroup>
    <ProjectReference Include="..\..\example\WolfCurses.Apps\WolfCurses.Apps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The mtp-off flavour on purpose. From 4.0 the plain xunit.v3 package brings Microsoft.Testing.Platform v2,
         whose build targets refuse a VSTest `dotnet test` outright on the .NET 10 SDK and later. This one is the
         same xunit with that left out, so `dotnet test` and its filter syntax keep working as documented. Moving
         to the platform runner instead means the plain package plus a global.json opting `dotnet test` into it. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
  </ItemGroup>

  <!-- The sample documents, next to the test binary in the documents/ folder DocumentLibrary resolves, exactly as
       the app copies them next to the executable. Without this every test that opens one would silently take the
       "could not open" path and still pass, which is the shape of dead test the arcade's chess artwork copy exists
       to prevent. -->
  <ItemGroup>
    <None Include="..\..\example\WolfCurses.Apps\Assets\documents\*.txt" Link="documents\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The sample card file, for the same reason and with the same hazard: the card file opens it at start-up, and
       without this every test about what is in it would take the "could not open" path and still pass. -->
  <ItemGroup>
    <None Include="..\..\example\WolfCurses.Apps\Assets\cards\*.csv" Link="cards\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
