<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- References the APPS suite, and nothing references this. That direction is the whole point of the project
       existing separately: WolfCurses.Tests tests the library and must never learn that an example exists, because
       the package has to ship without them. Anything here is free to reach into the example, since the example is
       already downstream of the library. -->
  <ItemGroup>
    <ProjectReference Include="..\..\example\WolfCurses.Apps\WolfCurses.Apps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <!-- The sample documents, next to the test binary in the documents/ folder DocumentLibrary resolves, exactly as
       the app copies them next to the executable. Without this every test that opens one would silently take the
       "could not open" path and still pass, which is the shape of dead test the arcade's chess artwork copy exists
       to prevent. -->
  <ItemGroup>
    <None Include="..\..\example\WolfCurses.Apps\Assets\documents\*.txt" Link="documents\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
